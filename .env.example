# Copy to /etc/default/muse-bridge or export these before starting bridge.py.
# Only needed if you use the push trigger and/or a public domain.

# Bridge POSTs new request ids here so the answer worker wakes instantly.
# Empty/unset = polling only (a cron/agent drains queue/pending/ instead).
PUSH_URL=

# Public base URL shown on the landing page and in generated snippets.
# If empty, the bridge falls back to the request's Host header.
PUBLIC_BASE_URL=
